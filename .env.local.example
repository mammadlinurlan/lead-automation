# Telegram Bot Token - @BotFather-dan alınır
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram qrup/kanal Chat ID (mənfi ədəd ola bilər)
TELEGRAM_CHAT_ID=your_chat_id_here

# Webhook doğrulama üçün gizli açar (yalnız A-Z, a-z, 0-9, _, - simvolları)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Odoo inteqrasiyası üçün (gələcəkdə)
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_odoo_email@example.com
ODOO_API_KEY=your_odoo_api_key
